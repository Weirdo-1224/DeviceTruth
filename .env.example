# 复制为已忽略的.env并设置自己的本地密码；不要提交.env。
DEVICETRUTH_DB_PASSWORD=
DEVICETRUTH_DB_PORT=54329
# 服务进程还需SPRING_DATASOURCE_URL/USERNAME/PASSWORD，见README。

# 知识导入/检索的真实 embedding：默认千问 text-embedding-v4（DashScope compatible-mode，1024维）。
# 专用 DEVICETRUTH_EMBEDDING_API_KEY 留空时复用 DASHSCOPE_API_KEY；也可放本地私有模型配置，不提交。
DEVICETRUTH_EMBEDDING_PROVIDER=openai
DEVICETRUTH_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEVICETRUTH_EMBEDDING_API_KEY=
DEVICETRUTH_EMBEDDING_MODEL=text-embedding-v4
DEVICETRUTH_EMBEDDING_DIMENSION=1024
DEVICETRUTH_EMBEDDING_PROFILE_REVISION=1
DEVICETRUTH_EMBEDDING_TIMEOUT_MS=15000
DEVICETRUTH_EMBEDDING_SEND_DIMENSIONS=true

# 密码恢复 SMTP：需支持 STARTTLS。PUBLIC_URL 必须 HTTPS，无查询或 fragment。
DEVICETRUTH_SMTP_HOST=smtp.qq.com
DEVICETRUTH_SMTP_PORT=587
DEVICETRUTH_SMTP_USERNAME=1192955713@qq.com
DEVICETRUTH_SMTP_PASSWORD=tswacrdcukdgfhhf
DEVICETRUTH_SMTP_FROM=1192955713@qq.com
DEVICETRUTH_PUBLIC_URL=
DEVICETRUTH_SMTP_CONNECT_TIMEOUT_MS=5000
DEVICETRUTH_SMTP_READ_TIMEOUT_MS=5000
DEVICETRUTH_SMTP_WRITE_TIMEOUT_MS=5000
