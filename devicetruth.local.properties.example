# Copy to devicetruth.local.properties in the project root, then fill in the key.
# Nonblank file values override environment variables. Never commit the private file.
# OpenAI-compatible service (DeepSeek defaults):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash

# Optional: Qwen via DashScope, selected with --reasoner=qwen
DASHSCOPE_API_KEY=
# Product Agent: scripted, qwen, or openai. Blank retains the application default.
DEVICETRUTH_AGENT_REASONER=

# Embedding: blank fields use environment variables or application defaults.
# API key falls back to DASHSCOPE_API_KEY when no dedicated key is configured.
DEVICETRUTH_EMBEDDING_PROVIDER=
DEVICETRUTH_EMBEDDING_BASE_URL=
DEVICETRUTH_EMBEDDING_API_KEY=
DEVICETRUTH_EMBEDDING_MODEL=
DEVICETRUTH_EMBEDDING_DIMENSION=
DEVICETRUTH_EMBEDDING_PROFILE_REVISION=
DEVICETRUTH_EMBEDDING_TIMEOUT_MS=
DEVICETRUTH_EMBEDDING_SEND_DIMENSIONS=

# Run event stream (SSE) tuning: blanks use application defaults.
# max-connections: global concurrent stream limit (default 64; overflow 503 STREAM_CAPACITY).
# ttl-minutes: per-connection TTL (default 60; expiry cleaned by emitter timeout).
DEVICETRUTH_STREAM_MAX_CONNECTIONS=
DEVICETRUTH_STREAM_TTL_MINUTES=
